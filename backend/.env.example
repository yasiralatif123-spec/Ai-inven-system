# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
# Number of trusted proxy hops. Keep as a NUMBER (1 behind the Next.js /api rewrite).
# Never set to "true" - express-rate-limit rejects permissive trust proxy settings.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/inv_system
# MUST point at a separate database used only by Jest. Tests refuse to run when
# this resolves to the same database name as MONGODB_URI.
MONGODB_TEST_URI=mongodb://localhost:27017/inv_system_test

# ---------------------------------------------------------------------------
# Auth secrets (REQUIRED - server crashes at startup if missing or < 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_strong_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_strong_random_refresh_secret_at_least_32_chars
TOKEN_PEPPER=replace_with_a_strong_random_pepper_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Cookies (same-origin /api proxy, HTTP-only, no localStorage tokens)
# ---------------------------------------------------------------------------
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
ACCESS_COOKIE_NAME=accessToken
REFRESH_COOKIE_NAME=refreshToken

# ---------------------------------------------------------------------------
# Email (Resend) - backend only, never expose the API key to the frontend
# Development uses the Resend test sender: onboarding@resend.dev
# Production requires a verified sender domain.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_placeholder
EMAIL_FROM="StockFlow <onboarding@resend.dev>"
APP_URL=http://localhost:3000
INVITE_EXPIRES_IN_HOURS=72
PASSWORD_RESET_EXPIRES_IN=1h

# ---------------------------------------------------------------------------
# Rollout flags (TODO: enable in staging immediately after Phase 5, then remove)
# ---------------------------------------------------------------------------
AUTH_ENFORCEMENT=false
TENANT_ENFORCEMENT=false

# ---------------------------------------------------------------------------
# Rate limits (defaults shown; per-IP keys use the trusted proxy hop above)
# ---------------------------------------------------------------------------
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW=15m
RATE_LIMIT_FORGOT_PASSWORD_LIMIT=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW=1h
RATE_LIMIT_INVITE_VALIDATE_LIMIT=20
RATE_LIMIT_INVITE_VALIDATE_WINDOW=1h
RATE_LIMIT_REFRESH_LIMIT=60
RATE_LIMIT_REFRESH_WINDOW=1h

# ---------------------------------------------------------------------------
# First-owner bootstrap (`npm run create-owner`) - no credentials are hardcoded.
# Prefer CLI flags; these env vars are the non-interactive alternative.
# ---------------------------------------------------------------------------
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
BUSINESS_NAME=

# ---------------------------------------------------------------------------
# Cloudinary (required for product image uploads)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
